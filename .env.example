# =========================================================
# Zenvy standalone demo -- environment variables
# =========================================================
# Copy this file to .env and fill in real values.
# Never commit the real .env file (it's already in .gitignore).

# ---------------------------------------------------------
# Required by STT, TTS, and the LLM client (services/config.py).
# Get this from your Sarvam AI dashboard.
# ---------------------------------------------------------
SARVAM_API_KEY=

# ---------------------------------------------------------
# Service-to-service URLs used by the Gateway to reach STT/TTS.
# Local defaults below match docker-compose / running each service
# on its own port. On Render, set these to the deployed STT/TTS
# service URLs (see the deployment guide), e.g.:
#   STT_URL=https://zenvy-stt.onrender.com/transcribe
#   TTS_URL=https://zenvy-tts.onrender.com/synthesize
# ---------------------------------------------------------
STT_URL=http://127.0.0.1:8001/transcribe
TTS_URL=http://127.0.0.1:8005/synthesize

# ---------------------------------------------------------
# NOTE -- everything else this demo used to need is gone:
#
# No TEAM_C_BASE_URL, no Supabase, no PostgreSQL, and no Redis. Login,
# conversation sessions, appointments, and in-progress booking state are
# all held in plain Python memory for the life of the process -- see
# services/demo_store.py and services/orchestrator/state_machine.py.
# SARVAM_API_KEY above is the only required external dependency.
# ---------------------------------------------------------
